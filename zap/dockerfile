
FROM ghcr.io/zaproxy/zaproxy:stable

USER root
RUN apt-get update && apt-get install -y netcat-openbsd curl && rm -rf /var/lib/apt/lists/*

# Create startup script with netcat proxy
RUN echo '#!/bin/bash' > /usr/local/bin/start.sh && \
    echo 'set -e' >> /usr/local/bin/start.sh && \
    echo 'echo "Starting ZAP..."' >> /usr/local/bin/start.sh && \
    echo 'su zap -c "zap.sh -daemon -host 127.0.0.1 -port 8081 -config api.key=aaef54aee7ea6b3df86e50f888a8d2c7 -config hud.enabled=false -config api.addrs.addr.name=.* -config api.addrs.addr.regex=true -config connection.followRedirect=false -config connection.postFormRedirects=false -config oast.service.callback.enabled=false -config network.proxy.chain.enabled=false -config network.connection.proxyChain.skipName=.* -config api.disablekey=false -config api.secure=false" &' >> /usr/local/bin/start.sh && \
    echo 'echo "Waiting for ZAP to be ready..."' >> /usr/local/bin/start.sh && \
    echo 'for i in {1..30}; do' >> /usr/local/bin/start.sh && \
    echo '    if curl -s http://127.0.0.1:8081/JSON/core/view/version/?apikey=aaef54aee7ea6b3df86e50f888a8d2c7 >/dev/null 2>&1; then' >> /usr/local/bin/start.sh && \
    echo '        echo "ZAP is ready!"' >> /usr/local/bin/start.sh && \
    echo '        break' >> /usr/local/bin/start.sh && \
    echo '    fi' >> /usr/local/bin/start.sh && \
    echo '    sleep 3' >> /usr/local/bin/start.sh && \
    echo 'done' >> /usr/local/bin/start.sh && \
    echo 'echo "Starting proxy on port $PORT..."' >> /usr/local/bin/start.sh && \
    echo 'while true; do' >> /usr/local/bin/start.sh && \
    echo '    nc -l -p $PORT -c "nc 127.0.0.1 8081"' >> /usr/local/bin/start.sh && \
    echo 'done' >> /usr/local/bin/start.sh

RUN chmod +x /usr/local/bin/start.sh

CMD ["/usr/local/bin/start.sh"]