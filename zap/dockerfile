# Use ZAP base image
FROM ghcr.io/zaproxy/zaproxy:stable

# Install nginx
USER root
RUN apt-get update && apt-get install -y nginx gettext-base && \
    rm -rf /var/lib/apt/lists/*

# Create nginx config template
COPY <<EOF /etc/nginx/conf.d/default.conf.template
server {
    listen \${PORT};
    server_name _;
    
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
EOF

# Remove default nginx config
RUN rm -f /etc/nginx/sites-enabled/default

# Create startup script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Start ZAP in background\n\
echo "Starting ZAP..."\n\
su zap -c "zap.sh -daemon -host 127.0.0.1 -port 8081 \\\n\
    -config api.key=aaef54aee7ea6b3df86e50f888a8d2c7 \\\n\
    -config hud.enabled=false \\\n\
    -config api.addrs.addr.name=.* \\\n\
    -config api.addrs.addr.regex=true \\\n\
    -config connection.followRedirect=false \\\n\
    -config connection.postFormRedirects=false \\\n\
    -config oast.service.callback.enabled=false \\\n\
    -config network.proxy.chain.enabled=false \\\n\
    -config network.connection.proxyChain.skipName=.* \\\n\
    -config api.disablekey=false" &\n\
\n\
# Wait for ZAP to start\n\
echo "Waiting for ZAP to start..."\n\
for i in {1..30}; do\n\
    if curl -s http://127.0.0.1:8081/JSON/core/view/version/ > /dev/null 2>&1; then\n\
        echo "ZAP started successfully"\n\
        break\n\
    fi\n\
    sleep 2\n\
done\n\
\n\
# Generate nginx config with PORT substitution\n\
echo "Configuring nginx..."\n\
envsubst < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf\n\
\n\
# Start nginx\n\
echo "Starting nginx on port $PORT..."\n\
nginx -g "daemon off;"' > /usr/local/bin/start.sh

RUN chmod +x /usr/local/bin/start.sh

CMD ["/usr/local/bin/start.sh"]