# Use ZAP base image
FROM ghcr.io/zaproxy/zaproxy:stable

# Install nginx and curl
USER root
RUN apt-get update && apt-get install -y nginx curl && \
    rm -rf /var/lib/apt/lists/*

# Remove default nginx config
RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf

# Create startup script
RUN echo '#!/bin/bash' > /usr/local/bin/start.sh && \
    echo 'set -e' >> /usr/local/bin/start.sh && \
    echo 'echo "Starting ZAP..."' >> /usr/local/bin/start.sh && \
    echo 'su zap -c "zap.sh -daemon -host 127.0.0.1 -port 8081 -config api.key=aaef54aee7ea6b3df86e50f888a8d2c7 -config hud.enabled=false -config api.addrs.addr.name=.* -config api.addrs.addr.regex=true -config connection.followRedirect=false -config connection.postFormRedirects=false -config oast.service.callback.enabled=false -config network.proxy.chain.enabled=false -config network.connection.proxyChain.skipName=.* -config api.disablekey=false" &' >> /usr/local/bin/start.sh && \
    echo 'echo "Waiting for ZAP to start..."' >> /usr/local/bin/start.sh && \
    echo 'for i in {1..30}; do' >> /usr/local/bin/start.sh && \
    echo '  if curl -s http://127.0.0.1:8081/JSON/core/view/version/ > /dev/null 2>&1; then' >> /usr/local/bin/start.sh && \
    echo '    echo "ZAP started successfully"' >> /usr/local/bin/start.sh && \
    echo '    break' >> /usr/local/bin/start.sh && \
    echo '  fi' >> /usr/local/bin/start.sh && \
    echo '  sleep 2' >> /usr/local/bin/start.sh && \
    echo 'done' >> /usr/local/bin/start.sh && \
    echo 'echo "Creating nginx config..."' >> /usr/local/bin/start.sh && \
    echo 'cat > /etc/nginx/conf.d/default.conf << "EOC"' >> /usr/local/bin/start.sh && \
    echo 'server {' >> /usr/local/bin/start.sh && \
    echo '    listen '$PORT';' >> /usr/local/bin/start.sh && \
    echo '    location / {' >> /usr/local/bin/start.sh && \
    echo '        proxy_pass http://127.0.0.1:8081;' >> /usr/local/bin/start.sh && \
    echo '        proxy_set_header Host $host;' >> /usr/local/bin/start.sh && \
    echo '    }' >> /usr/local/bin/start.sh && \
    echo '}' >> /usr/local/bin/start.sh && \
    echo 'EOC' >> /usr/local/bin/start.sh && \
    echo 'nginx -g "daemon off;"' >> /usr/local/bin/start.sh

RUN chmod +x /usr/local/bin/start.sh

EXPOSE 8080

CMD ["/usr/local/bin/start.sh"]