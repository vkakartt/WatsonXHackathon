FROM ghcr.io/zaproxy/zaproxy:stable

# Switch to root to install packages
USER root

# Install gettext-base for envsubst
RUN apt-get update && apt-get install -y gettext-base socat && rm -rf /var/lib/apt/lists/*

# Create a simple TCP proxy that forwards all traffic to ZAP
RUN echo '#!/bin/bash' > /usr/local/bin/start.sh && \
    echo 'set -e' >> /usr/local/bin/start.sh && \
    echo 'echo "Starting ZAP in headless mode..."' >> /usr/local/bin/start.sh && \
    echo 'su zap -c "zap.sh -daemon -host 127.0.0.1 -port 8081 -config api.key=aaef54aee7ea6b3df86e50f888a8d2c7 -config hud.enabled=false -config api.addrs.addr.name=.* -config api.addrs.addr.regex=true -config connection.followRedirect=false -config connection.postFormRedirects=false -config oast.service.callback.enabled=false -config network.proxy.chain.enabled=false -config network.connection.proxyChain.skipName=.* -config api.disablekey=false -config api.secure=false -config api.nohttps=true -config headless=true" &' >> /usr/local/bin/start.sh && \
    echo 'echo "Waiting for ZAP to start..."' >> /usr/local/bin/start.sh && \
    echo 'sleep 15' >> /usr/local/bin/start.sh && \
    echo 'echo "Starting TCP proxy on port $PORT forwarding to ZAP on 8081..."' >> /usr/local/bin/start.sh && \
    echo 'exec socat TCP4-LISTEN:$PORT,reuseaddr,fork TCP4:127.0.0.1:8081' >> /usr/local/bin/start.sh

RUN chmod +x /usr/local/bin/start.sh

CMD ["/usr/local/bin/start.sh"]