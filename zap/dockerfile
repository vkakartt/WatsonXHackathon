# Use ZAP base image
FROM ghcr.io/zaproxy/zaproxy:stable

# Install nginx and curl
USER root
RUN apt-get update && apt-get install -y nginx curl && \
    rm -rf /var/lib/apt/lists/*

# Remove default nginx config
RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf

# Create startup script that generates nginx config at runtime
RUN cat > /usr/local/bin/start.sh << 'EOF'
#!/bin/bash
set -e

echo "Starting ZAP..."
# Start ZAP in background
su zap -c "zap.sh -daemon -host 127.0.0.1 -port 8081 \
    -config api.key=aaef54aee7ea6b3df86e50f888a8d2c7 \
    -config hud.enabled=false \
    -config api.addrs.addr.name=.* \
    -config api.addrs.addr.regex=true \
    -config connection.followRedirect=false \
    -config connection.postFormRedirects=false \
    -config oast.service.callback.enabled=false \
    -config network.proxy.chain.enabled=false \
    -config network.connection.proxyChain.skipName=.* \
    -config api.disablekey=false" &

# Wait for ZAP to start
echo "Waiting for ZAP to start..."
for i in {1..30}; do
    if curl -s http://127.0.0.1:8081/JSON/core/view/version/ > /dev/null 2>&1; then
        echo "ZAP started successfully"
        break
    fi
    if [ $i -eq 30 ]; then
        echo "ZAP failed to start"
        exit 1
    fi
    sleep 2
done

# Create nginx config at runtime with proper PORT
echo "Creating nginx config for port $PORT..."
cat > /etc/nginx/conf.d/default.conf << EOC
server {
    listen $PORT;
    server_name _;
    
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host \$http_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}
EOC

# Test nginx config
echo "Testing nginx configuration..."
nginx -t

# Start nginx
echo "Starting nginx..."
nginx -g "daemon off;"
EOF

RUN chmod +x /usr/local/bin/start.sh

CMD ["/usr/local/bin/start.sh"]