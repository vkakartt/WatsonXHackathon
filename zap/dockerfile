# Use ZAP base image
FROM ghcr.io/zaproxy/zaproxy:stable

# Create startup script that uses environment PORT
RUN printf '#!/bin/bash\necho "Starting ZAP on port $PORT..."\nzap.sh -daemon \\\n    -host 0.0.0.0 \\\n    -port $PORT \\\n    -config api.key=aaef54aee7ea6b3df86e50f888a8d2c7 \\\n    -config hud.enabled=false \\\n    -config api.addrs.addr.name=.* \\\n    -config api.addrs.addr.regex=true \\\n    -config connection.followRedirect=false \\\n    -config connection.postFormRedirects=false \\\n    -config oast.service.callback.enabled=false \\\n    -config network.proxy.chain.enabled=false \\\n    -config network.connection.proxyChain.skipName=.* \\\n    -config api.disablekey=false \\\n    -config connection.timeoutInSecs=60 \\\n    -config api.secure=false\n' > /usr/local/bin/start.sh

RUN chmod +x /usr/local/bin/start.sh

CMD ["/usr/local/bin/start.sh"]